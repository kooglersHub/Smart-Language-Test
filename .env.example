# Server only. Never use NEXT_PUBLIC_ for API keys.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_ASSESSMENT_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
# Required in production; optional for local development. At least 16 characters.
ACCESS_CODE=
# Set the external HTTPS origin when using a reverse proxy (no trailing slash).
APP_ORIGIN=
